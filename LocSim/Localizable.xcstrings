        }
      }
    },
    "The connection to the device closed. Check Wi-Fi. LocSim reconnects on its own while a location is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät wurde getrennt. Prüfe das WLAN. Solange ein Standort aktiv ist, verbindet sich LocSim von selbst neu."
          }
        }
      }
    },
    "The Developer Disk Image could not be downloaded. Check the internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Developer Disk Image konnte nicht heruntergeladen werden. Prüfe die Internetverbindung."
          }
        }
      }
    },
    "The device did not accept the pairing file. Create a new one, for example after an iOS update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat die Pairing-Datei nicht akzeptiert. Erstelle eine neue, zum Beispiel nach einem iOS-Update."
          }
        }
      }
    },
    "The device did not provide location simulation. Turn on Mount Automatically under Settings, or restart the device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät stellt keine Standortsimulation bereit. Aktiviere „Automatisch einbinden“ in den Einstellungen oder starte das Gerät neu."
          }
        }
      }
    },
    "The disk image state could not be read. Check that Developer Mode is on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustand des Disk-Images konnte nicht gelesen werden. Prüfe, ob der Entwicklermodus aktiv ist."
          }
        }
      }
    },
    "The file could not be read. Create a new one with tools/make-pairing.sh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gelesen werden. Erstelle eine neue mit tools/make-pairing.sh."
          }
        }
      }
    },
    "The pairing file was not valid and has been removed. Run the setup script again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pairing-Datei war ungültig und wurde entfernt. Führe das Skript erneut aus."
