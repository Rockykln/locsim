    "Set on Selection sends a choice right away. Recent Locations keeps the last five." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei Auswahl setzen“ sendet eine Auswahl sofort. „Letzte Orte“ merkt sich die letzten fünf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Establecer al seleccionar” envía la selección al instante. “Ubicaciones recientes” guarda las cinco últimas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Définir à la sélection » envoie le choix aussitôt. « Lieux récents » garde les cinq derniers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Imposta alla selezione” invia subito la scelta. “Posizioni recenti” conserva le ultime cinque."
          }
