    "A free app from the App Store. Connect it before you set a location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kostenlose App aus dem App Store. Verbinde sie, bevor du einen Standort setzt."
          }
        }
      }
    },
    "A one-time setup with a computer and a USB cable. After that, LocSim works without a computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einmalige Einrichtung mit einem Computer und USB-Kabel. Danach funktioniert LocSim ohne Computer."
          }
        }
      }
    },
