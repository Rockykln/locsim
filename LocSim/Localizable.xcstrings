    },
    "The real location is back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der echte Standort ist zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación real ha vuelto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position réelle est rétablie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione reale è stata ripristinata."
          }
        }
      }
    },
    "The setup script copies it into LocSim. Otherwise, copy it with AirDrop or Finder and import it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Setup-Skript kopiert sie direkt in LocSim. Sonst kopiere sie per AirDrop oder Finder und importiere sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El script de configuración lo copia en LocSim. Si no, cópialo con AirDrop o el Finder e impórtalo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le script de configuration le copie dans LocSim. Sinon, copiez-le avec AirDrop ou le Finder et importez-le ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo script di configurazione lo copia in LocSim. Altrimenti copialo con AirDrop o il Finder e importalo qui."
          }
        }
      }
    },
    "This is a lockdown pairing file. LocSim needs the RPPairing file from the setup script." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist eine Lockdown-Pairing-Datei. LocSim benötigt die RPPairing-Datei aus dem Setup-Skript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
