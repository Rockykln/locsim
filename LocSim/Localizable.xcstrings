    "Connecting needs Wi-Fi, then cellular works too. “Keep Alive in Background” keeps the simulation running in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Verbinden ist WLAN nötig, danach reicht Mobilfunk. „Im Hintergrund aktiv halten“ lässt die Simulation im Hintergrund weiterlaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar se necesita Wi-Fi; después bastan los datos móviles. “Mantener activo en segundo plano” mantiene la simulación en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion nécessite le Wi-Fi, ensuite le réseau cellulaire suffit. « Maintenir actif en arrière-plan » garde la simulation active en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per connettersi serve il Wi-Fi, poi basta la rete cellulare. “Mantieni attivo in background” mantiene attiva la simulazione in background."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het verbinden is wifi nodig, daarna werkt ook mobiel netwerk. ‘Actief houden op achtergrond’ houdt de simulatie op de achtergrond actief."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar é preciso Wi-Fi, depois a rede celular também funciona. “Manter Ativo em Segundo Plano” mantém a simulação ativa em segundo plano."
          }
        }
      }
    },
