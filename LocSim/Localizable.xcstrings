    "Allow Local Network for LocSim under Settings > Privacy & Security > Local Network, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube LocSim das lokale Netzwerk unter Einstellungen > Datenschutz & Sicherheit > Lokales Netzwerk und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la red local para LocSim en Ajustes > Privacidad y seguridad > Red local y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le réseau local pour LocSim dans Réglages > Confidentialité et sécurité > Réseau local, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a LocSim l’accesso alla rete locale in Impostazioni > Privacy e sicurezza > Rete locale, poi riprova."
          }
        }
      }
    },
    "Allow location access for LocSim in Settings to show your position." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube LocSim den Standortzugriff in den Einstellungen, um deine Position anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación para LocSim en Ajustes para mostrar tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à la position pour LocSim dans Réglages afin d’afficher votre position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a LocSim l’accesso alla posizione in Impostazioni per mostrare dove ti trovi."
