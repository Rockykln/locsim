    "When you first set a location, iOS asks to add a VPN configuration. LocSim only uses it to reach this iPhone; no traffic leaves the device through it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Setzen eines Standorts fragt iOS, ob eine VPN-Konfiguration hinzugefügt werden darf. LocSim nutzt sie nur, um dieses iPhone zu erreichen. Darüber verlässt kein Datenverkehr das Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que estableces una ubicación, iOS pide añadir una configuración VPN. LocSim solo la usa para acceder a este iPhone. Ningún tráfico sale del dispositivo a través de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois que vous définissez une position, iOS demande d’ajouter une configuration VPN. LocSim l’utilise uniquement pour joindre cet iPhone. Aucun trafic ne quitte l’appareil par ce biais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima volta che imposti una posizione, iOS chiede di aggiungere una configurazione VPN. LocSim la usa solo per raggiungere questo iPhone. Nessun traffico esce dal dispositivo attraverso di essa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je voor het eerst een locatie instelt, vraagt iOS om een vpn-configuratie toe te voegen. LocSim gebruikt deze alleen om deze iPhone te bereiken. Er verlaat geen verkeer het apparaat via deze configuratie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na primeira vez que você define uma localização, o iOS pede para adicionar uma configuração de VPN. O LocSim a usa apenas para alcançar este iPhone. Nenhum tráfego sai do dispositivo por ela."
          }
        }
      }
    },
    "Without location access, the simulation stops in the background. Tap to allow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Standortzugriff stoppt die Simulation im Hintergrund. Tippe, um ihn zu erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a la ubicación, la simulación se detiene en segundo plano. Toca para permitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans accès à la position, la simulation s’arrête en arrière-plan. Touchez pour l’autoriser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza accesso alla posizione, la simulazione si interrompe in background. Tocca per consentirlo."
          }
        },
        "nl" : {
