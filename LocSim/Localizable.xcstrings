    },
    "The pairing file works with this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pairing-Datei funktioniert mit diesem Gerät."
          }
        }
      }
    },
    "The setup script copies it into LocSim. Otherwise, copy it with AirDrop or Finder and import it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Skript kopiert sie direkt in LocSim. Sonst kopiere sie per AirDrop oder Finder und importiere sie hier."
          }
        }
      }
    },
    "This is a lockdown pairing file. LocSim needs an RPPairing file from tools/make-pairing.sh." : {
