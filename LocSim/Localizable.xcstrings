    "Short Google Maps links are not supported. Open the link and copy the full address from the browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Google-Maps-Links werden nicht unterstützt. Öffne den Link und kopiere die vollständige Adresse aus dem Browser."
