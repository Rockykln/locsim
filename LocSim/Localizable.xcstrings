    "A one-time setup with a computer and a USB cable. After that, LocSim works without a computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einmalige Einrichtung mit einem Computer und USB-Kabel. Danach funktioniert LocSim ohne Computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración única con un ordenador y un cable USB. Después, LocSim funciona sin ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une configuration unique avec un ordinateur et un câble USB. Ensuite, LocSim fonctionne sans ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configurazione da fare una sola volta con un computer e un cavo USB. Dopo, LocSim funziona senza computer."
          }
        }
      }
    },
    "A running simulation stops. You need the setup script to create a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine laufende Simulation wird beendet. Für eine neue Datei brauchst du das Setup-Skript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detendrá la simulación en curso. Necesitas el script de configuración para crear uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une simulation en cours s’arrête. Le script de configuration est nécessaire pour en créer un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una simulazione in corso si interrompe. Per crearne uno nuovo serve lo script di configurazione."
          }
        }
      }
    },
