            "state" : "translated",
            "value" : "Zonder locatietoegang stopt de simulatie op de achtergrond. Tik om toe te staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso à localização, a simulação para em segundo plano. Toque para permitir."
