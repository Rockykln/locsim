    "A location is simulated." : {
      "comment" : "Shortcuts result",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird ein Standort simuliert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está simulando una ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une position est simulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È simulata una posizione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt een locatie gesimuleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma localização está sendo simulada."
          }
        }
