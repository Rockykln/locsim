      }
    },
    "The Developer Disk Image could not be downloaded. Check the internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Developer Disk Image konnte nicht heruntergeladen werden. Prüfe die Internetverbindung."
          }
        }
      }
    },
    "The device did not accept the pairing file. Create a new one, for example after an iOS update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat die Pairing-Datei nicht akzeptiert. Erstelle eine neue, zum Beispiel nach einem iOS-Update."
          }
        }
      }
    },
    "The device did not provide location simulation. Turn on Mount Automatically under Settings, or restart the device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät stellt keine Standortsimulation bereit. Aktiviere „Automatisch einbinden“ in den Einstellungen oder starte das Gerät neu."
          }
        }
      }
    },
    "The disk image state could not be read. Check that Developer Mode is on." : {
      "localizations" : {
