    "Connecting" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden …"
          }
        }
      }
    },
    "Connecting needs Wi-Fi, but no internet. After that, cellular works. Hostname must match the pairing file. Keep Alive uses background location so the simulation continues while LocSim is in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Verbinden ist WLAN nötig, Internet nicht. Danach geht auch Mobilfunk. Der Hostname muss zur Pairing-Datei passen. „Im Hintergrund aktiv halten“ nutzt den Standort im Hintergrund, damit die Simulation weiterläuft."
          }
        }
      }
    },
    "Connection" : {
      "localizations" : {
