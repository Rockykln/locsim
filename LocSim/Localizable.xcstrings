    "A one-time setup with a computer and a USB cable. After that, LocSim works without a computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einmalige Einrichtung mit einem Computer und USB-Kabel. Danach funktioniert LocSim ohne Computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configuración única con un ordenador y un cable USB. Después, LocSim funciona sin ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une configuration unique avec un ordinateur et un câble USB. Ensuite, LocSim fonctionne sans ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una configurazione da fare una sola volta con un computer e un cavo USB. Dopo, LocSim funziona senza computer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenmalige configuratie met een computer en een USB-kabel. Daarna werkt LocSim zonder computer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma configuração única com um computador e um cabo USB. Depois disso, o LocSim funciona sem computador."
          }
        }
      }
    },
    "A place name or address, for example Eiffel Tower or Alexanderplatz, Berlin" : {
      "comment" : "App Intent parameter description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
