    "The connection to the device broke off. Check Wi-Fi and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät ist abgebrochen. Prüfe das WLAN und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha interrumpido la conexión con el dispositivo. Comprueba la conexión Wi-Fi y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à l’appareil a été interrompue. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al dispositivo si è interrotta. Controlla il Wi-Fi e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met het apparaat is weggevallen. Controleer de wifi en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o dispositivo foi interrompida. Verifique o Wi-Fi e tente novamente."
          }
        }
      }
    },
    "The connection to the device closed. Check Wi-Fi. LocSim reconnects on its own while a location is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät wurde getrennt. Prüfe das WLAN. Solange ein Standort aktiv ist, verbindet sich LocSim von selbst neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la conexión con el dispositivo. Comprueba la conexión Wi-Fi. LocSim se vuelve a conectar automáticamente mientras haya una ubicación activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à l’appareil a été fermée. Vérifiez le Wi-Fi. LocSim se reconnecte automatiquement tant qu’une position est active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al dispositivo è stata chiusa. Controlla il Wi-Fi. Mentre una posizione è attiva, LocSim si riconnette da solo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met het apparaat is gesloten. Controleer de wifi. Zolang een locatie actief is, maakt LocSim zelf opnieuw verbinding."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o dispositivo foi encerrada. Verifique o Wi-Fi. O LocSim se reconecta sozinho enquanto uma localização estiver ativa."
          }
        }
      }
    },
    "The Developer Disk Image could not be downloaded. Check the internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Developer Disk Image konnte nicht heruntergeladen werden. Prüfe die Internetverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido descargar el Developer Disk Image. Comprueba la conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de télécharger le Developer Disk Image. Vérifiez la connexion à Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare la Developer Disk Image. Controlla la connessione a internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Developer Disk Image kon niet worden gedownload. Controleer de internetverbinding."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível baixar a Developer Disk Image. Verifique a conexão com a internet."
          }
        }
      }
    },
    "The device did not accept the pairing file. Check that the hostname in LocSim's settings matches the one used by the setup script, or create a new file, for example after an iOS update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat die Pairing-Datei nicht akzeptiert. Prüfe, ob der Hostname in den Einstellungen von LocSim mit dem im Setup-Skript übereinstimmt, oder erstelle eine neue Datei, zum Beispiel nach einem iOS-Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no ha aceptado el archivo de emparejamiento. Comprueba que el nombre de host de los ajustes de LocSim coincide con el del script de configuración o crea un archivo nuevo, por ejemplo, tras una actualización de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil n’a pas accepté le fichier de jumelage. Vérifiez que le nom d’hôte dans les réglages de LocSim correspond à celui du script de configuration, ou créez un nouveau fichier, par exemple après une mise à jour d’iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non ha accettato il file di abbinamento. Verifica che il nome host nelle impostazioni di LocSim corrisponda a quello usato dallo script di configurazione, oppure crea un nuovo file, ad esempio dopo un aggiornamento di iOS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat heeft het koppelingsbestand niet geaccepteerd. Controleer of de hostnaam in de instellingen van LocSim overeenkomt met die van het configuratiescript, of maak een nieuw bestand aan, bijvoorbeeld na een iOS-update."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo não aceitou o arquivo de emparelhamento. Verifique se o nome do host nos ajustes do LocSim corresponde ao usado pelo script de configuração ou crie um novo arquivo, por exemplo após uma atualização do iOS."
          }
        }
      }
    },
    "The device did not provide location simulation. Turn on Mount Automatically in LocSim's settings under Developer Disk Image, or restart the device." : {
      "comment" : "Error LS-400: what to do when the location service is missing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät stellt keine Standortsimulation bereit. Aktiviere „Automatisch einbinden“ in den Einstellungen von LocSim unter „Developer Disk Image“ oder starte das Gerät neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no ha proporcionado la simulación de ubicación. Activa “Montar automáticamente” en los ajustes de LocSim, en “Developer Disk Image”, o reinicia el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil n’a pas fourni la simulation de position. Activez « Monter automatiquement » dans les réglages de LocSim, sous « Developer Disk Image », ou redémarrez l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non ha reso disponibile la simulazione della posizione. Attiva “Monta automaticamente” nelle impostazioni di LocSim, in “Developer Disk Image”, o riavvia il dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat biedt geen locatiesimulatie. Schakel ‘Automatisch activeren’ in de instellingen van LocSim onder ‘Developer Disk Image’ in of herstart het apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo não forneceu a simulação de localização. Ative “Montar Automaticamente” nos ajustes do LocSim, em “Developer Disk Image”, ou reinicie o dispositivo."
          }
        }
      }
    },
    "The disk image state could not be read. Check that Developer Mode is on." : {
