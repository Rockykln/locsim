    "The connection to the device closed. Tap Set Location to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät wurde getrennt. Tippe auf „Standort setzen“, um neu zu verbinden."
