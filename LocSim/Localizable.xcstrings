    "The connection to the device broke off. Check Wi-Fi and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät ist abgebrochen. Prüfe das WLAN und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha interrumpido la conexión con el dispositivo. Comprueba la conexión Wi-Fi y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à l’appareil a été interrompue. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al dispositivo si è interrotta. Controlla il Wi-Fi e riprova."
          }
        }
      }
    },
    "The connection to the device closed. Check Wi-Fi. LocSim reconnects on its own while a location is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Gerät wurde getrennt. Prüfe das WLAN. Solange ein Standort aktiv ist, verbindet sich LocSim von selbst neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la conexión con el dispositivo. Comprueba la conexión Wi-Fi. LocSim se vuelve a conectar automáticamente mientras haya una ubicación activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à l’appareil a été fermée. Vérifiez le Wi-Fi. LocSim se reconnecte automatiquement tant qu’une position est active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al dispositivo è stata chiusa. Controlla il Wi-Fi. Mentre una posizione è attiva, LocSim si riconnette da solo."
          }
        }
      }
    },
    "The Developer Disk Image could not be downloaded. Check the internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Developer Disk Image konnte nicht heruntergeladen werden. Prüfe die Internetverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido descargar el Developer Disk Image. Comprueba la conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de télécharger le Developer Disk Image. Vérifiez la connexion à Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare la Developer Disk Image. Controlla la connessione a internet."
          }
        }
      }
    },
    "The device did not accept the pairing file. Check that the hostname in LocSim's settings matches the one used by the setup script, or create a new file, for example after an iOS update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat die Pairing-Datei nicht akzeptiert. Prüfe, ob der Hostname in den Einstellungen von LocSim mit dem im Setup-Skript übereinstimmt, oder erstelle eine neue Datei, zum Beispiel nach einem iOS-Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no ha aceptado el archivo de emparejamiento. Comprueba que el nombre de host de los ajustes de LocSim coincide con el del script de configuración o crea un archivo nuevo, por ejemplo, tras una actualización de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil n’a pas accepté le fichier de jumelage. Vérifiez que le nom d’hôte dans les réglages de LocSim correspond à celui du script de configuration, ou créez un nouveau fichier, par exemple après une mise à jour d’iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non ha accettato il file di abbinamento. Verifica che il nome host nelle impostazioni di LocSim corrisponda a quello usato dallo script di configurazione, oppure crea un nuovo file, ad esempio dopo un aggiornamento di iOS."
          }
        }
      }
    },
    "The device did not provide location simulation. Turn on Mount Automatically under Settings, or restart the device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät stellt keine Standortsimulation bereit. Aktiviere „Automatisch einbinden“ in den Einstellungen oder starte das Gerät neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no ha proporcionado la simulación de ubicación. Activa “Montar automáticamente” en Ajustes o reinicia el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil n’a pas fourni la simulation de position. Activez « Monter automatiquement » dans Réglages ou redémarrez l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non ha reso disponibile la simulazione della posizione. Attiva “Monta automaticamente” in Impostazioni o riavvia il dispositivo."
          }
        }
      }
    },
    "The disk image state could not be read. Check that Developer Mode is on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustand des Developer Disk Image konnte nicht gelesen werden. Prüfe, ob der Entwicklermodus aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer el estado del Developer Disk Image. Comprueba que el modo de desarrollador está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire l’état du Developer Disk Image. Vérifiez que le mode développeur est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere lo stato della Developer Disk Image. Verifica che Modalità sviluppatore sia attiva."
          }
        }
      }
    },
    "The file could not be read. Create a new one with the setup script." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gelesen werden. Erstelle eine neue mit dem Setup-Skript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer el archivo. Crea uno nuevo con el script de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le fichier. Créez-en un nouveau avec le script de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il file. Creane uno nuovo con lo script di configurazione."
          }
        }
      }
    },
    "The location of this iPhone does not change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort dieses iPhones ändert sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación de este iPhone no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position de cet iPhone ne change pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione di questo iPhone non cambia."
          }
        }
      }
    },
    "The pairing file was not valid and has been removed. Run the setup script again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pairing-Datei war ungültig und wurde entfernt. Führe das Setup-Skript erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de emparejamiento no era válido y se ha eliminado. Vuelve a ejecutar el script de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de jumelage n’était pas valide et a été supprimé. Exécutez de nouveau le script de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file di abbinamento non era valido ed è stato rimosso. Esegui di nuovo lo script di configurazione."
          }
        }
      }
    },
    "The pairing file works with this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pairing-Datei funktioniert mit diesem Gerät."
          }
        },
        "es" : {
