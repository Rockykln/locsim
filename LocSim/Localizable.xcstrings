    "Returns the place LocSim simulates, with its name and coordinates. Fails when no location is simulated." : {
      "comment" : "Shortcuts action description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt den Ort zurück, den LocSim simuliert, mit Name und Koordinaten. Schlägt fehl, wenn kein Standort simuliert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el lugar que simula LocSim, con su nombre y coordenadas. Falla si no se simula ninguna ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie le lieu que LocSim simule, avec son nom et ses coordonnées. Échoue si aucune position n’est simulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce il luogo simulato da LocSim, con nome e coordinate. Non riesce se nessuna posizione è simulata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft de plaats terug die LocSim simuleert, met naam en coördinaten. Mislukt als er geen locatie wordt gesimuleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna o local que o LocSim simula, com nome e coordenadas. Falha se nenhuma localização estiver sendo simulada."
          }
        }
      }
    },
    "Returns true while LocSim simulates a location, otherwise false." : {
      "comment" : "Shortcuts action description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt „wahr“ zurück, solange LocSim einen Standort simuliert, sonst „falsch“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve verdadero mientras LocSim simula una ubicación y falso en caso contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie vrai tant que LocSim simule une position, sinon faux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
