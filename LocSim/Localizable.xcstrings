    "LocSim could not start its connection to this iPhone. Allow the VPN configuration when iOS asks and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocSim konnte die Verbindung zu diesem iPhone nicht starten. Erlaube die VPN-Konfiguration, wenn iOS danach fragt, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocSim no ha podido iniciar su conexión con este iPhone. Permite la configuración VPN cuando iOS lo pida y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocSim n’a pas pu démarrer sa connexion à cet iPhone. Autorisez la configuration VPN lorsque iOS le demande, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocSim non è riuscito ad avviare la connessione a questo iPhone. Consenti la configurazione VPN quando iOS lo chiede e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocSim kon de verbinding met deze iPhone niet starten. Sta de vpn-configuratie toe wanneer iOS erom vraagt en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LocSim não conseguiu iniciar a conexão com este iPhone. Permita a configuração de VPN quando o iOS solicitar e tente novamente."
          }
        }
      }
    },
    "LocSim is not set up yet. Open LocSim and follow the setup steps." : {
      "localizations" : {
        "de" : {
