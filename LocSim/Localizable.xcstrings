    "Installing the disk image failed. It needs an internet connection; try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation des Disk-Images ist fehlgeschlagen. Dafür ist eine Internetverbindung nötig. Versuche es erneut."
          }
