    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deinen Standort auf der Karte. Während ein Standort simuliert wird, nutzt LocSim die Ortung im Hintergrund, um die Verbindung zu diesem iPhone offen zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your position on the map. While a location is simulated, LocSim uses location in the background to keep its connection to this iPhone open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu ubicación en el mapa. Mientras se simula una ubicación, LocSim usa la ubicación en segundo plano para mantener abierta su conexión con este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche votre position sur la carte. Pendant la simulation d’une position, LocSim utilise la localisation en arrière-plan pour garder ouverte sa connexion à cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la tua posizione sulla mappa. Mentre simula una posizione, LocSim usa la localizzazione in background per mantenere aperta la connessione a questo iPhone."
          }
        }
      }
    }
  },
  "version" : "1.0"
