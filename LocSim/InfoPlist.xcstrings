    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deinen Standort auf der Karte. Während ein Standort simuliert wird, prüft LocSim im Hintergrund, ob iOS ihn auf deinen echten Standort zurückgesetzt hat, und setzt den simulierten erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your position on the map. While a location is simulated, LocSim checks in the background whether iOS has reset it to your real location, and sets the simulated one again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu ubicación en el mapa. Mientras se simula una ubicación, LocSim comprueba en segundo plano si iOS la ha restablecido a tu ubicación real y vuelve a establecer la simulada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche votre position sur la carte. Pendant la simulation d’une position, LocSim vérifie en arrière-plan si iOS l’a remise à votre position réelle et rétablit la position simulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la tua posizione sulla mappa. Mentre simula una posizione, LocSim controlla in background se iOS l’ha riportata alla tua posizione reale e reimposta quella simulata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont je positie op de kaart. Terwijl een locatie wordt gesimuleerd, controleert LocSim op de achtergrond of iOS die heeft teruggezet naar je echte locatie, en stelt de gesimuleerde opnieuw in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a sua posição no mapa. Enquanto uma localização é simulada, o LocSim verifica em segundo plano se o iOS a redefiniu para a sua localização real e define a simulada novamente."
          }
        }
      }
    }
  },
  "version" : "1.0"
}