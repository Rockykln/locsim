*.mobiledevicepairing
*.mobiledevicepair

# Tools
tools/bin/

# Local mirror of third-party downloads (tools/fetch-vendor.sh)
vendor/

.DS_Store

# Website
site/.wrangler/
site/app-link/.wrangler/
site/node_modules/

# Rendered mockups (App Store sizes)
design/mockups/out/

# Simulator screenshots are large and only an input for the renderer
design/screenshots/*
!design/screenshots/.gitkeep

# Python
__pycache__/
