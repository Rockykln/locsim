# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.ipa
*.xcarchive
ExportOptions.plist

# Build inputs fetched or generated locally
Frameworks/
Config/Local.xcconfig
Config/Commit.xcconfig

